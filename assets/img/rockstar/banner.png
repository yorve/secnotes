<svg viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0e14"/>
      <stop offset="100%" stop-color="#11161d"/>
    </linearGradient>
    <radialGradient id="glow" cx="15%" cy="100%" r="70%">
      <stop offset="0%" stop-color="#22c55e" stop-opacity="0.16"/>
      <stop offset="100%" stop-color="#22c55e" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="36" height="36" patternUnits="userSpaceOnUse">
      <path d="M 36 0 L 0 0 0 36" fill="none" stroke="#1c2128" stroke-width="1"/>
    </pattern>
  </defs>

  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect width="1200" height="630" fill="url(#grid)"/>
  <rect width="1200" height="630" fill="url(#glow)"/>

  <!-- top status line -->
  <text x="60" y="76" font-family="SFMono-Regular, Consolas, monospace" font-size="22" fill="#4ade80">&gt;_ SecNotes // Writeup</text>
  <circle cx="1128" cy="68" r="6" fill="#4ade80"/>

  <!-- title -->
  <text x="58" y="250" font-family="Arial Black, Arial, sans-serif" font-size="108" font-weight="900" fill="#f0f6fc" letter-spacing="1">ROCKSTAR</text>
  <rect x="62" y="272" width="340" height="7" fill="#4ade80"/>

  <!-- subtitle -->
  <text x="60" y="330" font-family="Arial, sans-serif" font-size="27" fill="#8b949e">TheHackerLabs &#183; Linux &#183; LFI to Root</text>

  <!-- chain line, small caps like KABOOM card -->
  <text x="60" y="368" font-family="SFMono-Regular, Consolas, monospace" font-size="16" fill="#6e7681" letter-spacing="1">LFI &gt; LEAKED CREDS &gt; SUDO HIJACK &gt; PYTHON HIJACK &gt; BEANSHELL &gt; ROOT</text>

  <!-- tag pills -->
  <g font-family="SFMono-Regular, Consolas, monospace" font-size="18">
    <rect x="60" y="400" width="88" height="40" rx="8" fill="none" stroke="#2ea043" stroke-width="1.5"/>
    <text x="104" y="426" text-anchor="middle" fill="#4ade80">LFI</text>

    <rect x="160" y="400" width="120" height="40" rx="8" fill="none" stroke="#2ea043" stroke-width="1.5"/>
    <text x="220" y="426" text-anchor="middle" fill="#4ade80">Sudoers</text>

    <rect x="292" y="400" width="130" height="40" rx="8" fill="none" stroke="#2ea043" stroke-width="1.5"/>
    <text x="357" y="426" text-anchor="middle" fill="#4ade80">Hijacking</text>

    <rect x="434" y="400" width="150" height="40" rx="8" fill="none" stroke="#2ea043" stroke-width="1.5"/>
    <text x="509" y="426" text-anchor="middle" fill="#4ade80">BeanShell</text>
  </g>

  <!-- status bottom right, humor like KABOOM's STATUS: ROOTED -->
  <text x="1140" y="440" text-anchor="end" font-family="SFMono-Regular, Consolas, monospace" font-size="18" fill="#4ade80" letter-spacing="1">STATUS: ROOTED</text>

  <!-- site watermark bottom -->
  <text x="60" y="580" font-family="SFMono-Regular, Consolas, monospace" font-size="18" fill="#6e7681">yorve.github.io/secnotes</text>

  <!-- blinking cursor -->
  <rect x="440" y="226" width="14" height="60" fill="#4ade80"/>
</svg>
